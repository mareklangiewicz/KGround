#!/usr/bin/env bash
# Diff template-raw's source-set graph against template-full's.
#
# The convergence goal (iterate on both until they meet, THEN delete one) needs an oracle, because
# both templates build green while their graphs differ. This prints exactly what still differs.
#
# Empty output == converged, as far as source sets, dependsOn edges and declared dependencies go.
#
# Usage:
#   ./kgroundx-maintenance/converge-diff            # the diff
#   ./kgroundx-maintenance/converge-diff --dumps    # also keep the two raw dumps for inspection
#
# Runs one Gradle invocation per template, sequentially and with --stop in between: two KMP
# configurations at once is what chokes a laptop with little RAM (see gate.sh for the same reason).

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(dirname "$here")"
init="$here/dump-source-sets.init.gradle.kts"
out="${TMPDIR:-/tmp}/kground-converge-$$"
mkdir -p "$out"

keep_dumps=false
[[ "${1:-}" == "--dumps" ]] && keep_dumps=true

dump() { # $1 = template dir name
  local tpl="$1"
  # Only the ':'-prefixed probe lines: Gradle and the DepsKt settings plugin both chatter on stdout,
  # and that chatter is not part of what is being compared.
  ( cd "$root/$tpl" && ./gradlew --init-script "$init" -q dumpSourceSets 2>/dev/null ) \
    | grep '^:' | sort > "$out/$tpl.txt"
  ( cd "$root/$tpl" && ./gradlew --stop >/dev/null 2>&1 ) || true
  echo "  $tpl: $(wc -l < "$out/$tpl.txt") lines" >&2
}

echo "Dumping source-set graphs.." >&2
dump template-raw
dump template-full

echo >&2
if diff -u "$out/template-raw.txt" "$out/template-full.txt" \
     --label "template-raw" --label "template-full"; then
  echo "CONVERGED: source-set graphs are identical." >&2
  status=0
else
  status=1
fi

if $keep_dumps; then
  echo >&2
  echo "Dumps kept in $out" >&2
else
  rm -rf "$out"
fi
exit $status
